# ---------------------------------------------------------------------------
# Firebase Web SDK config (client-side).
# These are NOT secret — Firebase web config is safe to ship in the browser;
# access is controlled by Firestore/Storage security rules, not by hiding keys.
#
# Get these from: Firebase Console -> Project settings -> "Your apps" -> Web app.
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
# Copy the storageBucket value from your Web app config exactly — it is either
# your-project.appspot.com or your-project.firebasestorage.app depending on the project age.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Cloudflare Pages Function secrets (server-side ONLY).
# Do NOT put these in .env.local with a VITE_ prefix — set them in the
# Cloudflare Pages dashboard under Settings -> Environment variables, and for
# local `wrangler pages dev` testing put them in `.dev.vars` (git-ignored).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=re_xxxxxxxx
# QUOTE_NOTIFY_TO=sales@mindalnoor.com
# QUOTE_NOTIFY_FROM=Mind Alnoor Website <website@yourdomain.com>
