rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An account is an admin only if a doc exists at admins/{uid}.
    // Create these manually in the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // managed in the console only
    }

    match /products/{id} {
      // Public can read published products; admins can read everything.
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /quoteRequests/{id} {
      // Anyone may submit a request, with a sanity-checked shape.
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt is number;
      allow read, update, delete: if isAdmin();
    }
  }
}
